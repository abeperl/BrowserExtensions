{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Pdf": {
    "ChromiumDownloadMode": "Auto",
    "CacheDirectory": "chromium-cache",
    "NavigationTimeoutSeconds": 45,
    "PageWidthInches": 8.27,
    "PageHeightInches": 11.69,
    "MarginMillimeters": 10,
    "Landscape": false,
    "PrintBackground": true,
    "WaitForNetworkIdleMs": 3000,
    "WaitForSelector": "#PicklistNumber",
