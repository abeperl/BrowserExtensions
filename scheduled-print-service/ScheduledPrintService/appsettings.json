    "MinimumDataRows": 1,
    "CaptureDiagnosticScreenshot": true,
    "DebugLogNetworkResponses": true,
    "NetworkLogUrlPattern": "",
    "DataLoadRetryMs": 10000
  },
  "Printer": {
    "Mode": "Windows",
    "PrinterName": "NPI84BD10 (HP LaserJet M607)",
