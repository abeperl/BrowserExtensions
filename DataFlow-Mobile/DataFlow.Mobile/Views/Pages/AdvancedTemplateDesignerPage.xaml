<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DataFlow.Mobile.Views.Pages.AdvancedTemplateDesignerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:DataFlow.Mobile.ViewModels"
    xmlns:models="clr-namespace:DataFlow.Mobile.Models"
    x:DataType="viewmodels:AdvancedTemplateDesignerViewModel"
    Title="Advanced Template Designer">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Save"
            IconImageSource="save.png"
            Command="{Binding SaveTemplateCommand}" />
        <ToolbarItem
            Text="Export"
            IconImageSource="export.png"
            Command="{Binding ExportTemplateCommand}" />
        <ToolbarItem
            Text="Import"
            IconImageSource="import.png"
            Command="{Binding ImportTemplateCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="20,15">
            <StackLayout>
                <Label
                    Text="{Binding CurrentTemplate.Name}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White" />
                <Label
                    Text="Advanced Template Designer with Visual Editor"
                    FontSize="14"
                    TextColor="LightGray" />
            </StackLayout>
        </Grid>

        <!-- Designer Mode Selector -->
        <Frame Grid.Row="1" BackgroundColor="White" Padding="15,10" HasShadow="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label
                    Grid.Column="0"
                    Text="Designer Mode:"
                    FontSize="16"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    TextColor="{StaticResource Primary}" />

                <Picker
                    Grid.Column="1"
                    ItemsSource="{Binding DesignerModes}"
                    SelectedItem="{Binding DesignerMode}"
                    BackgroundColor="{StaticResource Gray50}"
                    Margin="10,0" />

                <Button
                    Grid.Column="2"
                    Text="🔄 Preview"
                    FontSize="14"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    CornerRadius="15"
                    Padding="15,8"
                    Command="{Binding GeneratePreviewDataCommand}" />
            </Grid>
        </Frame>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="2">
            <StackLayout Spacing="0">

                <!-- Visual Designer Mode -->
                <StackLayout IsVisible="{Binding DesignerMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Visual'}">

                    <!-- Quick Actions -->
                    <Frame BackgroundColor="{StaticResource Gray50}" Padding="20,15" HasShadow="False">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button
                                Grid.Column="0"
                                Text="➕ Add Column"
                                FontSize="14"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="20"
                                Command="{Binding AddColumnCommand}" />

                            <Button
                                Grid.Column="1"
                                Text="🎨 Apply Theme"
                                FontSize="14"
                                BackgroundColor="{StaticResource Tertiary}"
                                TextColor="White"
                                CornerRadius="20"
                                Command="{Binding ApplyColorSchemeCommand}" />

                            <Button
                                Grid.Column="2"
                                Text="📐 Apply Layout"
                                FontSize="14"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="White"
                                CornerRadius="20"
                                Command="{Binding ApplyLayoutTemplateCommand}" />
                        </Grid>
                    </Frame>

                    <!-- Color Scheme Selection -->
                    <StackLayout Padding="20" BackgroundColor="White">
                        <Label Text="Color Scheme" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                        <CollectionView
                            ItemsSource="{Binding ColorSchemes}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedColorScheme}"
                            HeightRequest="120">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ColorScheme">
                                    <Frame
                                        BackgroundColor="{Binding BackgroundColor}"
                                        Padding="15,10"
                                        CornerRadius="8"
                                        HasShadow="True"
                                        WidthRequest="120">
                                        <StackLayout Spacing="5">
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{Binding TextColor}"
                                                HorizontalOptions="Center" />
                                            <BoxView
                                                BackgroundColor="{Binding AccentColor}"
                                                HeightRequest="3"
                                                CornerRadius="1" />
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                    <!-- Layout Template Selection -->
                    <StackLayout Padding="20" BackgroundColor="{StaticResource Gray50}">
                        <Label Text="Layout Template" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                        <CollectionView
                            ItemsSource="{Binding LayoutTemplates}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedLayoutTemplate}"
                            HeightRequest="100">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:LayoutTemplate">
                                    <Frame
                                        BackgroundColor="White"
                                        Padding="15"
                                        CornerRadius="8"
                                        HasShadow="True"
                                        WidthRequest="100">
                                        <StackLayout Spacing="5">
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}"
                                                HorizontalOptions="Center" />
                                            <Label
                                                Text="{Binding DisplayType}"
                                                FontSize="10"
                                                TextColor="{StaticResource Gray600}"
                                                HorizontalOptions="Center" />
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                    <!-- Column Designer -->
                    <StackLayout Padding="20" BackgroundColor="White">
                        <Label Text="Column Configuration" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                        <CollectionView
                            ItemsSource="{Binding DesignerColumns}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedColumn}"
                            BackgroundColor="Transparent">

                            <CollectionView.EmptyView>
                                <StackLayout
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Spacing="10"
                                    Padding="40">
                                    <Label
                                        Text="📊"
                                        FontSize="48"
                                        HorizontalOptions="Center" />
                                    <Label
                                        Text="No columns configured"
                                        FontSize="16"
                                        TextColor="{StaticResource Gray600}"
                                        HorizontalOptions="Center" />
                                    <Label
                                        Text="Add your first column to get started"
                                        FontSize="14"
                                        TextColor="{StaticResource Gray500}"
                                        HorizontalOptions="Center" />
                                </StackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TemplateColumn">
                                    <Grid Margin="0,5">
                                        <Frame
                                            BackgroundColor="{Binding BackgroundColor, FallbackValue='{StaticResource Gray50}'}"
                                            HasShadow="True"
                                            CornerRadius="8"
                                            Padding="15">

                                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">

                                                <!-- Column Header -->
                                                <StackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                                    <Label
                                                        Text="{Binding DisplayName}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="{Binding TextColor, FallbackValue='{StaticResource Gray900}'}" />
                                                    <Label
                                                        Text="{Binding Name, StringFormat='Field: {0}'}"
                                                        FontSize="12"
                                                        TextColor="{StaticResource Gray600}" />
                                                </StackLayout>

                                                <!-- Column Actions -->
                                                <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                    <Button
                                                        Text="↑"
                                                        FontSize="14"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        TextColor="White"
                                                        CornerRadius="12"
                                                        Padding="8"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AdvancedTemplateDesignerViewModel}}, Path=MoveColumnUpCommand}"
                                                        CommandParameter="{Binding .}" />
                                                    <Button
                                                        Text="↓"
                                                        FontSize="14"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        TextColor="White"
                                                        CornerRadius="12"
                                                        Padding="8"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AdvancedTemplateDesignerViewModel}}, Path=MoveColumnDownCommand}"
                                                        CommandParameter="{Binding .}" />
                                                    <Button
                                                        Text="📋"
                                                        FontSize="14"
                                                        BackgroundColor="{StaticResource Secondary}"
                                                        TextColor="White"
                                                        CornerRadius="12"
                                                        Padding="8"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AdvancedTemplateDesignerViewModel}}, Path=DuplicateColumnCommand}"
                                                        CommandParameter="{Binding .}" />
                                                    <Button
                                                        Text="🗑️"
                                                        FontSize="14"
                                                        BackgroundColor="Red"
                                                        TextColor="White"
                                                        CornerRadius="12"
                                                        Padding="8"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AdvancedTemplateDesignerViewModel}}, Path=RemoveColumnCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </StackLayout>

                                                <!-- Column Properties -->
                                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                    <StackLayout Grid.Column="0" Spacing="5">
                                                        <Label Text="Data Type" FontSize="12" TextColor="{StaticResource Gray600}" />
                                                        <Label
                                                            Text="{Binding DataType}"
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            TextColor="{StaticResource Primary}" />
                                                    </StackLayout>
                                                    <StackLayout Grid.Column="1" Spacing="5">
                                                        <Label Text="Width" FontSize="12" TextColor="{StaticResource Gray600}" />
                                                        <Label
                                                            Text="{Binding Width, StringFormat='{0}px'}"
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            TextColor="{StaticResource Primary}" />
                                                    </StackLayout>
                                                    <StackLayout Grid.Column="2" Spacing="5">
                                                        <Label Text="Alignment" FontSize="12" TextColor="{StaticResource Gray600}" />
                                                        <Label
                                                            Text="{Binding TextAlignment}"
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            TextColor="{StaticResource Primary}" />
                                                    </StackLayout>
                                                </Grid>

                                                <!-- Column Features -->
                                                <StackLayout Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="15">
                                                    <StackLayout Orientation="Horizontal" Spacing="5">
                                                        <Label Text="👁️" FontSize="14" />
                                                        <Label
                                                            Text="{Binding IsVisible, Converter={StaticResource BoolToStatusConverter}}"
                                                            FontSize="12"
                                                            TextColor="{Binding IsVisible, Converter={StaticResource BoolToColorConverter}}" />
                                                    </StackLayout>
                                                    <StackLayout Orientation="Horizontal" Spacing="5">
                                                        <Label Text="🔄" FontSize="14" />
                                                        <Label
                                                            Text="{Binding IsSortable, Converter={StaticResource BoolToStatusConverter}}"
                                                            FontSize="12"
                                                            TextColor="{Binding IsSortable, Converter={StaticResource BoolToColorConverter}}" />
                                                    </StackLayout>
                                                    <StackLayout Orientation="Horizontal" Spacing="5">
                                                        <Label Text="🔍" FontSize="14" />
                                                        <Label
                                                            Text="{Binding IsFilterable, Converter={StaticResource BoolToStatusConverter}}"
                                                            FontSize="12"
                                                            TextColor="{Binding IsFilterable, Converter={StaticResource BoolToColorConverter}}" />
                                                    </StackLayout>
                                                </StackLayout>

                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                </StackLayout>

                <!-- Code Editor Mode -->
                <StackLayout IsVisible="{Binding DesignerMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Code'}" Padding="20">
                    <Label Text="Template JSON Configuration" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                    <Frame
                        BackgroundColor="{StaticResource Gray100}"
                        Padding="15"
                        CornerRadius="8"
                        HasShadow="False">
                        <ScrollView HeightRequest="400">
                            <Label
                                Text="{Binding TemplateCode}"
                                FontFamily="Courier"
                                FontSize="12"
                                TextColor="{StaticResource Gray800}"
                                LineBreakMode="WordWrap" />
                        </ScrollView>
                    </Frame>
                </StackLayout>

                <!-- Preview Mode -->
                <StackLayout IsVisible="{Binding DesignerMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Preview'}" Padding="20">
                    <Label Text="Template Preview" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                    <Frame
                        BackgroundColor="White"
                        HasShadow="True"
                        CornerRadius="8"
                        Padding="15">
                        <ScrollView HeightRequest="400">
                            <Label
                                Text="{Binding PreviewData}"
                                FontFamily="Courier"
                                FontSize="12"
                                TextColor="{StaticResource Gray800}"
                                LineBreakMode="WordWrap" />
                        </ScrollView>
                    </Frame>
                </StackLayout>

            </StackLayout>
        </ScrollView>

    </Grid>

    <!-- Loading Overlay -->
    <Grid
        BackgroundColor="#80000000"
        IsVisible="{Binding IsLoading}">
        <ActivityIndicator
            IsRunning="{Binding IsLoading}"
            Color="{StaticResource Primary}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
    </Grid>

</ContentPage>