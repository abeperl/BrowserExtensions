<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DataFlow.Mobile.Views.Pages.ActionConfigurationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:DataFlow.Mobile.ViewModels"
    x:DataType="viewmodels:ActionConfigurationViewModel"
    Title="Action Configuration">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Save"
            IconImageSource="save.png"
            Command="{Binding SaveActionsCommand}" />
        <ToolbarItem
            Text="Import"
            IconImageSource="import.png"
            Command="{Binding ImportActionsCommand}" />
        <ToolbarItem
            Text="Export"
            IconImageSource="export.png"
            Command="{Binding ExportActionsCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Spacing="0">

            <!-- Header -->
            <Grid BackgroundColor="{StaticResource Primary}" Padding="20,15">
                <StackLayout>
                    <Label
                        Text="{Binding CurrentPage.Name}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White" />
                    <Label
                        Text="Configure actions and user interactions"
                        FontSize="14"
                        TextColor="LightGray" />
                </StackLayout>
            </Grid>

            <!-- Actions List -->
            <StackLayout Padding="20" BackgroundColor="White">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                    <Label
                        Grid.Column="0"
                        Text="Page Actions"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Text="+ Add Action"
                        FontSize="14"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="15"
                        Padding="15,8"
                        Command="{Binding AddActionCommand}" />
                </Grid>

                <CollectionView
                    ItemsSource="{Binding PageActions}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedAction}"
                    BackgroundColor="Transparent">

                    <CollectionView.EmptyView>
                        <StackLayout
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Spacing="10"
                            Padding="40">
                            <Label
                                Text="⚡"
                                FontSize="48"
                                HorizontalOptions="Center" />
                            <Label
                                Text="No actions configured"
                                FontSize="16"
                                TextColor="{StaticResource Gray600}"
                                HorizontalOptions="Center" />
                            <Label
                                Text="Add your first action to get started"
                                FontSize="14"
                                TextColor="{StaticResource Gray500}"
                                HorizontalOptions="Center" />
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Action">
                            <Grid Margin="0,5">
                                <Frame
                                    BackgroundColor="{StaticResource Gray50}"
                                    HasShadow="True"
                                    CornerRadius="8"
                                    Padding="15">

                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">

                                        <!-- Action Header -->
                                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Gray900}" />
                                            <Label
                                                Text="{Binding Type}"
                                                FontSize="12"
                                                TextColor="{StaticResource Primary}"
                                                BackgroundColor="{StaticResource Gray100}"
                                                Padding="5,2"
                                                HorizontalOptions="Start" />
                                        </StackLayout>

                                        <!-- Action Controls -->
                                        <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Switch
                                                IsToggled="{Binding IsEnabled}"
                                                OnColor="{StaticResource Primary}"
                                                VerticalOptions="Center" />
                                            <Button
                                                Text="📋"
                                                FontSize="14"
                                                BackgroundColor="{StaticResource Secondary}"
                                                TextColor="White"
                                                CornerRadius="12"
                                                Padding="8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActionConfigurationViewModel}}, Path=DuplicateActionCommand}"
                                                CommandParameter="{Binding .}" />
                                            <Button
                                                Text="🗑️"
                                                FontSize="14"
                                                BackgroundColor="Red"
                                                TextColor="White"
                                                CornerRadius="12"
                                                Padding="8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActionConfigurationViewModel}}, Path=RemoveActionCommand}"
                                                CommandParameter="{Binding .}" />
                                        </StackLayout>

                                        <!-- Action Details -->
                                        <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="5">
                                            <Label
                                                Text="{Binding Description}"
                                                FontSize="14"
                                                TextColor="{StaticResource Gray700}"
                                                IsVisible="{Binding Description, Converter={StaticResource StringToBoolConverter}}" />
                                            <StackLayout Orientation="Horizontal" Spacing="15">
                                                <Label
                                                    Text="{Binding Order, StringFormat='Order: {0}'}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource Gray600}" />
                                                <Label
                                                    Text="{Binding CreatedAt, StringFormat='Created: {0:MM/dd/yyyy}'}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource Gray600}" />
                                            </StackLayout>
                                        </StackLayout>

                                    </Grid>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Action Configuration Panel -->
            <StackLayout
                Padding="20"
                BackgroundColor="{StaticResource Gray50}"
                IsVisible="{Binding SelectedAction, Converter={StaticResource NotNullToBoolConverter}}">

                <Label Text="Action Configuration" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                <!-- Basic Action Settings -->
                <StackLayout Spacing="15" Margin="0,0,0,20">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Text="Action Name" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        <Entry
                            Grid.Row="1"
                            Text="{Binding SelectedAction.Name}"
                            Placeholder="Enter action name"
                            BackgroundColor="White" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Text="Action Type" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        <Picker
                            Grid.Row="1"
                            ItemsSource="{Binding ActionTypes}"
                            SelectedItem="{Binding SelectedAction.Type}"
                            BackgroundColor="White" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Text="Description" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        <Editor
                            Grid.Row="1"
                            Text="{Binding SelectedAction.Description}"
                            Placeholder="Enter action description"
                            BackgroundColor="White"
                            HeightRequest="80" />
                    </Grid>
                </StackLayout>

                <!-- Advanced Configuration Toggle -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                    <Label
                        Grid.Column="0"
                        Text="Advanced Configuration"
                        FontSize="16"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        TextColor="{StaticResource Primary}" />
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsAdvancedMode}"
                        OnColor="{StaticResource Primary}" />
                </Grid>

                <!-- Advanced Configuration Panel -->
                <StackLayout IsVisible="{Binding IsAdvancedMode}" Spacing="20">

                    <!-- Action Parameters -->
                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <Label
                                Grid.Column="0"
                                Text="Parameters"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}" />
                            <Button
                                Grid.Column="1"
                                Text="+ Add"
                                FontSize="12"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="12"
                                Padding="10,5"
                                Command="{Binding AddParameterCommand}" />
                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding ActionParameters}"
                            BackgroundColor="Transparent">

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ActionParameter">
                                    <Grid Margin="0,5">
                                        <Frame BackgroundColor="White" Padding="10" CornerRadius="5">
                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                                                <Entry
                                                    Grid.Column="0"
                                                    Text="{Binding Name}"
                                                    Placeholder="Name"
                                                    FontSize="12" />
                                                <Entry
                                                    Grid.Column="1"
                                                    Text="{Binding Value}"
                                                    Placeholder="Value"
                                                    FontSize="12" />
                                                <Button
                                                    Grid.Column="2"
                                                    Text="✕"
                                                    FontSize="12"
                                                    BackgroundColor="Red"
                                                    TextColor="White"
                                                    CornerRadius="8"
                                                    Padding="5"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActionConfigurationViewModel}}, Path=RemoveParameterCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                    <!-- Action Conditions -->
                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <Label
                                Grid.Column="0"
                                Text="Conditions"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}" />
                            <Button
                                Grid.Column="1"
                                Text="+ Add"
                                FontSize="12"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="12"
                                Padding="10,5"
                                Command="{Binding AddConditionCommand}" />
                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding ActionConditions}"
                            BackgroundColor="Transparent">

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ActionCondition">
                                    <Grid Margin="0,5">
                                        <Frame BackgroundColor="White" Padding="10" CornerRadius="5">
                                            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="10">
                                                <Entry
                                                    Grid.Column="0"
                                                    Text="{Binding Field}"
                                                    Placeholder="Field"
                                                    FontSize="12" />
                                                <Picker
                                                    Grid.Column="1"
                                                    SelectedItem="{Binding Operator}"
                                                    FontSize="12"
                                                    WidthRequest="80">
                                                    <Picker.Items>
                                                        <x:String>equals</x:String>
                                                        <x:String>not_equals</x:String>
                                                        <x:String>greater</x:String>
                                                        <x:String>less</x:String>
                                                        <x:String>contains</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                                <Entry
                                                    Grid.Column="2"
                                                    Text="{Binding Value}"
                                                    Placeholder="Value"
                                                    FontSize="12" />
                                                <Button
                                                    Grid.Column="3"
                                                    Text="✕"
                                                    FontSize="12"
                                                    BackgroundColor="Red"
                                                    TextColor="White"
                                                    CornerRadius="8"
                                                    Padding="5"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActionConfigurationViewModel}}, Path=RemoveConditionCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                    <!-- Custom Script Editor -->
                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <Label
                                Grid.Column="0"
                                Text="Custom Script"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}" />
                            <Button
                                Grid.Column="1"
                                Text="📝 Generate"
                                FontSize="12"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="White"
                                CornerRadius="12"
                                Padding="10,5"
                                Command="{Binding GenerateActionScriptCommand}" />
                        </Grid>

                        <Frame BackgroundColor="White" Padding="10" CornerRadius="5">
                            <ScrollView HeightRequest="200">
                                <Editor
                                    Text="{Binding ActionScript}"
                                    FontFamily="Courier"
                                    FontSize="12"
                                    BackgroundColor="Transparent"
                                    Placeholder="// Enter custom JavaScript code here..." />
                            </ScrollView>
                        </Frame>
                    </StackLayout>

                </StackLayout>

                <!-- Action Testing -->
                <StackLayout Margin="0,20,0,0">
                    <Label Text="Action Testing" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,10" />

                    <Button
                        Text="🧪 Test Action"
                        FontSize="16"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        CornerRadius="20"
                        Padding="15,10"
                        Command="{Binding TestActionCommand}"
                        IsEnabled="{Binding IsTestingAction, Converter={StaticResource InvertedBoolConverter}}"
                        Margin="0,0,0,10" />

                    <ActivityIndicator
                        IsVisible="{Binding IsTestingAction}"
                        IsRunning="{Binding IsTestingAction}"
                        Color="{StaticResource Primary}"
                        Margin="0,0,0,10" />

                    <Frame
                        BackgroundColor="{StaticResource Gray100}"
                        Padding="15"
                        CornerRadius="8"
                        IsVisible="{Binding TestResult, Converter={StaticResource StringToBoolConverter}}">
                        <Label
                            Text="{Binding TestResult}"
                            FontSize="14"
                            TextColor="{StaticResource Gray800}"
                            LineBreakMode="WordWrap" />
                    </Frame>
                </StackLayout>

            </StackLayout>

        </StackLayout>
    </ScrollView>

    <!-- Loading Overlay -->
    <Grid
        BackgroundColor="#80000000"
        IsVisible="{Binding IsLoading}">
        <ActivityIndicator
            IsRunning="{Binding IsLoading}"
            Color="{StaticResource Primary}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
    </Grid>

</ContentPage>