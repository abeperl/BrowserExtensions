<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DataFlow.Mobile.Views.Pages.PageWizardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:DataFlow.Mobile.ViewModels"
    xmlns:models="clr-namespace:DataFlow.Mobile.Models"
    xmlns:controls="clr-namespace:DataFlow.Mobile.Views.Controls"
    x:DataType="viewmodels:PageWizardViewModel"
    Title="{Binding WizardTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Cancel"
            IconImageSource="cancel.png"
            Command="{Binding CancelWizardCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Progress Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="20,15">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

                <!-- Step Progress -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*">
                    <Ellipse
                        Grid.Column="0"
                        Fill="{StaticResource White}"
                        WidthRequest="30"
                        HeightRequest="30"
                        HorizontalOptions="Center" />
                    <Line
                        Grid.Column="0"
                        X1="15"
                        Y1="15"
                        X2="45"
                        Y2="15"
                        Stroke="{Binding CurrentStep, Converter={StaticResource StepProgressConverter}, ConverterParameter=2}"
                        StrokeThickness="3"
                        HorizontalOptions="End" />

                    <Ellipse
                        Grid.Column="1"
                        Fill="{Binding CurrentStep, Converter={StaticResource StepProgressConverter}, ConverterParameter=2}"
                        WidthRequest="30"
                        HeightRequest="30"
                        HorizontalOptions="Center" />
                    <Line
                        Grid.Column="1"
                        X1="15"
                        Y1="15"
                        X2="45"
                        Y2="15"
                        Stroke="{Binding CurrentStep, Converter={StaticResource StepProgressConverter}, ConverterParameter=3}"
                        StrokeThickness="3"
                        HorizontalOptions="End" />

                    <Ellipse
                        Grid.Column="2"
                        Fill="{Binding CurrentStep, Converter={StaticResource StepProgressConverter}, ConverterParameter=3}"
                        WidthRequest="30"
                        HeightRequest="30"
                        HorizontalOptions="Center" />
                    <Line
                        Grid.Column="2"
                        X1="15"
                        Y1="15"
                        X2="45"
                        Y2="15"
                        Stroke="{Binding CurrentStep, Converter={StaticResource StepProgressConverter}, ConverterParameter=4}"
                        StrokeThickness="3"
                        HorizontalOptions="End" />

                    <Ellipse
                        Grid.Column="3"
                        Fill="{Binding CurrentStep, Converter={StaticResource StepProgressConverter}, ConverterParameter=4}"
                        WidthRequest="30"
                        HeightRequest="30"
                        HorizontalOptions="Center" />
                    <Line
                        Grid.Column="3"
                        X1="15"
                        Y1="15"
                        X2="45"
                        Y2="15"
                        Stroke="{Binding CurrentStep, Converter={StaticResource StepProgressConverter}, ConverterParameter=5}"
                        StrokeThickness="3"
                        HorizontalOptions="End" />

                    <Ellipse
                        Grid.Column="4"
                        Fill="{Binding CurrentStep, Converter={StaticResource StepProgressConverter}, ConverterParameter=5}"
                        WidthRequest="30"
                        HeightRequest="30"
                        HorizontalOptions="Center" />
                </Grid>

                <!-- Step Title -->
                <Label
                    Grid.Row="1"
                    Text="{Binding CurrentStep, Converter={StaticResource StepTitleConverter}}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center" />

                <!-- Step Description -->
                <Label
                    Grid.Row="2"
                    Text="{Binding CurrentStep, Converter={StaticResource StepDescriptionConverter}}"
                    FontSize="14"
                    TextColor="LightGray"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

            </Grid>
        </Grid>

        <!-- Step Content -->
        <ScrollView Grid.Row="1">

            <!-- Step 1: Basic Information -->
            <StackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" Padding="20">

                <Label Text="Page Information" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                <!-- Page Name -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Page Name *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Entry
                        Grid.Row="1"
                        Text="{Binding PageConfiguration.Name}"
                        Placeholder="Enter a descriptive name for your page"
                        BackgroundColor="White" />
                </Grid>

                <!-- Description -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Description" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Editor
                        Grid.Row="1"
                        Text="{Binding PageConfiguration.Description}"
                        Placeholder="Optional description of what this page displays"
                        HeightRequest="80"
                        BackgroundColor="White" />
                </Grid>

                <!-- API Endpoint -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="API Endpoint URL *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Entry
                        Grid.Row="1"
                        Text="{Binding PageConfiguration.ApiEndpoint}"
                        Placeholder="https://api.example.com/data"
                        Keyboard="Url"
                        BackgroundColor="White" />
                </Grid>

                <!-- HTTP Method -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="HTTP Method" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Picker
                        Grid.Row="1"
                        ItemsSource="{Binding AvailableHttpMethods}"
                        SelectedItem="{Binding PageConfiguration.ApiMethod}"
                        BackgroundColor="White" />
                </Grid>

                <!-- Category -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Category" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Entry
                        Grid.Row="1"
                        Text="{Binding PageConfiguration.Category}"
                        Placeholder="Optional category for organization"
                        BackgroundColor="White" />
                </Grid>

            </StackLayout>

            <!-- Step 2: API Configuration -->
            <StackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}" Padding="20">

                <Label Text="API Configuration" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                <!-- Request Headers -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Request Headers (JSON)" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Editor
                        Grid.Row="1"
                        Text="{Binding PageConfiguration.RequestHeaders}"
                        Placeholder='{"Content-Type": "application/json", "Accept": "application/json"}'
                        HeightRequest="100"
                        BackgroundColor="White" />
                </Grid>

                <!-- Request Parameters -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Query Parameters (JSON)" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Editor
                        Grid.Row="1"
                        Text="{Binding PageConfiguration.RequestParameters}"
                        Placeholder='{"limit": 50, "sort": "created_at"}'
                        HeightRequest="100"
                        BackgroundColor="White" />
                </Grid>

                <!-- Test Connection -->
                <StackLayout Margin="0,20,0,0">
                    <Button
                        Text="🔗 Test API Connection"
                        FontSize="16"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        CornerRadius="25"
                        Padding="20,12"
                        Command="{Binding TestConnectionCommand}"
                        IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InvertedBoolConverter}}" />

                    <ActivityIndicator
                        IsVisible="{Binding IsTestingConnection}"
                        IsRunning="{Binding IsTestingConnection}"
                        Color="{StaticResource Primary}"
                        Margin="0,10" />

                    <Frame
                        BackgroundColor="{Binding TestSuccessful, Converter={StaticResource BoolToTestResultColorConverter}}"
                        Padding="15"
                        CornerRadius="8"
                        Margin="0,10"
                        IsVisible="{Binding TestResult, Converter={StaticResource StringToBoolConverter}}">
                        <Label
                            Text="{Binding TestResult}"
                            TextColor="White"
                            FontSize="14"
                            HorizontalTextAlignment="Center" />
                    </Frame>
                </StackLayout>

            </StackLayout>

            <!-- Step 3: Authentication -->
            <StackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}" Padding="20">

                <Label Text="Authentication Setup" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                <!-- Authentication Type -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Authentication Type" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Picker
                        Grid.Row="1"
                        ItemsSource="{Binding AvailableAuthTypes}"
                        SelectedItem="{Binding AuthConfiguration.AuthenticationType}"
                        BackgroundColor="White" />
                </Grid>

                <!-- Bearer Token Configuration -->
                <StackLayout IsVisible="{Binding AuthConfiguration.AuthenticationType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Bearer Token'}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                        <Label Grid.Row="0" Text="Bearer Token" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        <Entry
                            Grid.Row="1"
                            Text="{Binding AuthConfiguration.TokenValue}"
                            Placeholder="Enter your bearer token"
                            IsPassword="True"
                            BackgroundColor="White" />
                    </Grid>
                </StackLayout>

                <!-- API Key Configuration -->
                <StackLayout IsVisible="{Binding AuthConfiguration.AuthenticationType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='API Key'}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                        <Label Grid.Row="0" Text="API Key Header Name" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        <Entry
                            Grid.Row="1"
                            Text="{Binding AuthConfiguration.ApiKeyHeader}"
                            Placeholder="X-API-Key"
                            BackgroundColor="White" />
                    </Grid>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                        <Label Grid.Row="0" Text="API Key Value" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        <Entry
                            Grid.Row="1"
                            Text="{Binding AuthConfiguration.ApiKeyValue}"
                            Placeholder="Enter your API key"
                            IsPassword="True"
                            BackgroundColor="White" />
                    </Grid>
                </StackLayout>

                <!-- Basic Authentication -->
                <StackLayout IsVisible="{Binding AuthConfiguration.AuthenticationType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Basic Authentication'}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                        <Label Grid.Row="0" Text="Username" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        <Entry
                            Grid.Row="1"
                            Text="{Binding AuthConfiguration.Username}"
                            Placeholder="Enter username"
                            BackgroundColor="White" />
                    </Grid>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                        <Label Grid.Row="0" Text="Password" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                        <Entry
                            Grid.Row="1"
                            Text="{Binding AuthConfiguration.Password}"
                            Placeholder="Enter password"
                            IsPassword="True"
                            BackgroundColor="White" />
                    </Grid>
                </StackLayout>

            </StackLayout>

            <!-- Step 4: Template Design -->
            <StackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}" Padding="20">

                <Label Text="Template Design" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,15" />

                <!-- Template Name -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Template Name" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Entry
                        Grid.Row="1"
                        Text="{Binding TemplateConfiguration.Name}"
                        Placeholder="Enter template name"
                        BackgroundColor="White" />
                </Grid>

                <!-- Color Scheme -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Color Scheme" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Picker
                        Grid.Row="1"
                        ItemsSource="{Binding AvailableColorSchemes}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding TemplateConfiguration.ColorScheme}"
                        BackgroundColor="White" />
                </Grid>

                <!-- Layout Template -->
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,15">
                    <Label Grid.Row="0" Text="Layout Style" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Picker
                        Grid.Row="1"
                        ItemsSource="{Binding AvailableLayoutTemplates}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding TemplateConfiguration.LayoutTemplate}"
                        BackgroundColor="White" />
                </Grid>

                <!-- Auto-Generate Button -->
                <Button
                    Text="🎨 Auto-Generate Template"
                    FontSize="16"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="White"
                    CornerRadius="25"
                    Padding="20,12"
                    Command="{Binding AutoGenerateTemplateCommand}"
                    Margin="0,20,0,0" />

                <!-- Preview -->
                <StackLayout Margin="0,20,0,0" IsVisible="{Binding PreviewData, Converter={StaticResource NotNullToBoolConverter}}">
                    <Label Text="Preview" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray700}" Margin="0,0,0,10" />

                    <controls:DynamicTemplateView
                        ProcessedData="{Binding PreviewData}"
                        Template="{Binding TemplateConfiguration}"
                        LayoutType="{Binding TemplateConfiguration.LayoutTemplate.LayoutType}"
                        HeightRequest="300" />
                </StackLayout>

            </StackLayout>

            <!-- Step 5: Review & Finish -->
            <StackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}" Padding="20">

                <Label Text="Review & Finish" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,0,0,20" />

                <!-- Page Summary -->
                <Frame BackgroundColor="White" HasShadow="True" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackLayout Spacing="10">
                        <Label Text="Page Configuration" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Name:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding PageConfiguration.Name}" FontSize="14" TextColor="{StaticResource Gray800}" />

                            <Label Grid.Row="1" Grid.Column="0" Text="API:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PageConfiguration.ApiEndpoint}" FontSize="14" TextColor="{StaticResource Gray800}" LineBreakMode="TailTruncation" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Method:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding PageConfiguration.ApiMethod}" FontSize="14" TextColor="{StaticResource Gray800}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Auth:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding AuthConfiguration.AuthenticationType}" FontSize="14" TextColor="{StaticResource Gray800}" />
                        </Grid>
                    </StackLayout>
                </Frame>

                <!-- Template Summary -->
                <Frame BackgroundColor="White" HasShadow="True" CornerRadius="12" Padding="20">
                    <StackLayout Spacing="10">
                        <Label Text="Template Configuration" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Name:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding TemplateConfiguration.Name}" FontSize="14" TextColor="{StaticResource Gray800}" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Theme:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding TemplateConfiguration.ColorScheme.Name}" FontSize="14" TextColor="{StaticResource Gray800}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Layout:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding TemplateConfiguration.LayoutTemplate.Name}" FontSize="14" TextColor="{StaticResource Gray800}" />
                        </Grid>
                    </StackLayout>
                </Frame>

            </StackLayout>

        </ScrollView>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" BackgroundColor="{StaticResource Gray100}" Padding="20,15">
            <Button
                Grid.Column="0"
                Text="← Previous"
                FontSize="16"
                BackgroundColor="{StaticResource Gray600}"
                TextColor="White"
                CornerRadius="25"
                Padding="20,12"
                Command="{Binding PreviousStepCommand}"
                IsVisible="{Binding CurrentStep, Converter={StaticResource IntGreaterThanConverter}, ConverterParameter=1}" />

            <Button
                Grid.Column="1"
                Text="{Binding CurrentStep, Converter={StaticResource NextButtonTextConverter}}"
                FontSize="16"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                CornerRadius="25"
                Padding="20,12"
                Command="{Binding NextStepCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

        <!-- Loading Overlay -->
        <Grid
            Grid.RowSpan="3"
            BackgroundColor="#80000000"
            IsVisible="{Binding IsLoading}">
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                Color="{StaticResource Primary}"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>