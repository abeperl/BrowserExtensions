<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DataFlow.Mobile.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:DataFlow.Mobile.ViewModels"
    x:DataType="viewmodels:AboutPageViewModel"
    Title="About">

    <ScrollView>
        <StackLayout Spacing="0">

            <!-- Header Section -->
            <Grid BackgroundColor="{StaticResource Primary}" Padding="30,40,30,30">
                <StackLayout HorizontalOptions="Center" Spacing="15">

                    <!-- App Icon Placeholder -->
                    <Frame
                        BackgroundColor="White"
                        CornerRadius="25"
                        HasShadow="True"
                        HeightRequest="100"
                        WidthRequest="100"
                        HorizontalOptions="Center"
                        Padding="0">
                        <Label
                            Text="📊"
                            FontSize="50"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Frame>

                    <Label
                        Text="{Binding AppName}"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Dynamic API Data Visualization Platform"
                        FontSize="16"
                        TextColor="LightGray"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding AppVersion, StringFormat='Version {0}'}"
                        FontSize="14"
                        TextColor="LightGray"
                        HorizontalOptions="Center" />

                </StackLayout>
            </Grid>

            <!-- Features Section -->
            <StackLayout Padding="25,30" BackgroundColor="{StaticResource Gray50}">
                <Label
                    Text="Key Features"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Gray700}"
                    Margin="0,0,0,15" />

                <StackLayout Spacing="15">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0" Text="🌐" FontSize="24" VerticalOptions="Center" />
                        <StackLayout Grid.Column="1">
                            <Label Text="API Integration" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Connect to any REST API endpoint with authentication support" FontSize="13" TextColor="{StaticResource Gray600}" />
                        </StackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0" Text="🎨" FontSize="24" VerticalOptions="Center" />
                        <StackLayout Grid.Column="1">
                            <Label Text="Custom Templates" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Design beautiful layouts with configurable styling and themes" FontSize="13" TextColor="{StaticResource Gray600}" />
                        </StackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0" Text="⚡" FontSize="24" VerticalOptions="Center" />
                        <StackLayout Grid.Column="1">
                            <Label Text="Interactive Actions" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Create buttons, dropdowns, and forms that interact with your APIs" FontSize="13" TextColor="{StaticResource Gray600}" />
                        </StackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0" Text="🔊" FontSize="24" VerticalOptions="Center" />
                        <StackLayout Grid.Column="1">
                            <Label Text="Audio Feedback" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Customizable sound effects for actions and interactions" FontSize="13" TextColor="{StaticResource Gray600}" />
                        </StackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                        <Label Grid.Column="0" Text="📱" FontSize="24" VerticalOptions="Center" />
                        <StackLayout Grid.Column="1">
                            <Label Text="Cross-Platform" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Text="Native performance on iOS and Android devices" FontSize="13" TextColor="{StaticResource Gray600}" />
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </StackLayout>

            <!-- Action Buttons Section -->
            <StackLayout Padding="25,20" Spacing="15">
                <Button
                    Text="📧 Send Feedback"
                    FontSize="16"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="25"
                    Padding="20,12"
                    Command="{Binding SendFeedbackCommand}" />

                <Button
                    Text="🌟 Share App"
                    FontSize="16"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    CornerRadius="25"
                    Padding="20,12"
                    Command="{Binding ShareAppCommand}" />

                <Button
                    Text="🔓 Open Source Licenses"
                    FontSize="16"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="White"
                    CornerRadius="25"
                    Padding="20,12"
                    Command="{Binding ViewLicensesCommand}" />

                <Button
                    Text="🛡️ Privacy Policy"
                    FontSize="16"
                    BackgroundColor="{StaticResource Gray600}"
                    TextColor="White"
                    CornerRadius="25"
                    Padding="20,12"
                    Command="{Binding ViewPrivacyPolicyCommand}" />
            </StackLayout>

            <!-- Technical Info Section -->
            <StackLayout Padding="25" BackgroundColor="{StaticResource Gray100}">
                <Label
                    Text="Technical Information"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Gray700}"
                    Margin="0,0,0,15" />

                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="15">
                    <Label Grid.Row="0" Grid.Column="0" Text="Version:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" FontSize="14" TextColor="{StaticResource Gray800}" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Build Date:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding BuildDate}" FontSize="14" TextColor="{StaticResource Gray800}" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Framework:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding FrameworkVersion, StringFormat='.NET {0}'}" FontSize="14" TextColor="{StaticResource Gray800}" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Platform:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding DeviceInfo}" FontSize="14" TextColor="{StaticResource Gray800}" />
                </Grid>
            </StackLayout>

            <!-- Footer Section -->
            <StackLayout Padding="25,30" HorizontalOptions="Center">
                <Label
                    Text="Made with ❤️ using .NET MAUI"
                    FontSize="14"
                    TextColor="{StaticResource Gray500}"
                    HorizontalOptions="Center" />

                <Label
                    Text="© 2024 DataFlow Mobile. All rights reserved."
                    FontSize="12"
                    TextColor="{StaticResource Gray400}"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0" />
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>